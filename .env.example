# ==============================================================================
# SiteScout AI - Canonical Environment Configuration Example (.env.example)
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Runtime Environment (development | testing | staging | production)
NODE_ENV=development
PORT=3000

# Public App Hosting URL
APP_URL=https://example.com
PUBLIC_APP_URL=https://example.com

# Allowed CORS Origins (comma-separated URLs)
ALLOWED_ORIGINS=https://example.com,http://localhost:3000

# Gemini AI API Key (Required for live AI website and copy generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Webhook & Signing Secrets
OUTREACH_WEBHOOK_SECRET=your_outreach_webhook_secret_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Vercel Deployment Token (Optional: Required for live website deployment)
VERCEL_API_TOKEN=your_vercel_api_token_here

# Client-Side Firebase Configuration (Public web app identifiers)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
