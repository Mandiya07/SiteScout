rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the caller is a verified admin or bootstrapped administrator
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'siphom.yati@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'Admin']
        )
      );
    }

    // Helper function to check document ownership via userId or ownerId fields
    function isOwner(data) {
      return isSignedIn() && (
        ( 'userId' in data && data.userId == request.auth.uid ) ||
        ( 'ownerId' in data && data.ownerId == request.auth.uid )
      );
    }

    // User profiles & user-scoped subcollections (e.g. /users/{userId}/businesses/{businessId})
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Nested user-owned subcollections (e.g. /users/{userId}/businesses/{businessId})
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // PRIVATE Sites collection: Strictly private! NO public get access.
    // Restricted strictly to document owner or admin.
    match /sites/{siteId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    // PUBLIC Previews collection: Public single-doc read access ONLY for clients viewing website presentation prototypes.
    // Sanitized document containing presentation layout, theme colors, copy, and client feedback (no private CRM notes).
    match /publicPreviews/{previewToken} {
      allow get: if true;
      allow list: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create, update: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        !('userId' in request.resource.data) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    // Prospects / Businesses collection: strict user ownership & isolation
    match /businesses/{businessId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    // Proposals collection: strict user ownership isolation (User A <-> User A, User B <-> User B, Admin <-> All)
    match /proposals/{proposalId} {
      // Public single-doc view access for clients opening proposal share links
      allow get: if true;
      // Listing/querying restricted strictly to document owner or admin
      allow list: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      // Creating proposals requires setting userId/ownerId to caller's UID
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      // Updating or deleting proposal requires ownership or admin
      allow update, delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }
  }
}
