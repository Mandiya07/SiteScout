rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the caller is a verified admin or bootstrapped administrator
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'siphom.yati@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'Admin']
        )
      );
    }

    // Helper function to check document ownership via userId or ownerId fields
    function isOwner(data) {
      return isSignedIn() && (
        ( 'userId' in data && data.userId == request.auth.uid ) ||
        ( 'ownerId' in data && data.ownerId == request.auth.uid )
      );
    }

    // Helper function to ensure immutable ownership fields are not modified during updates
    function maintainsOwnership(newData, oldData) {
      return !newData.diff(oldData).affectedKeys().hasAny(['userId', 'ownerId', 'createdBy']);
    }

    // User profiles & user-scoped subcollections
    // PREVENTS PRIVILEGE ESCALATION: Ordinary users cannot grant themselves 'admin' role
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'user' || 
        request.resource.data.role == 'User' ||
        request.auth.token.email == 'siphom.yati@gmail.com'
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId && (
            !('role' in request.resource.data) || 
            request.resource.data.role == resource.data.get('role', 'user')
          )
        )
      );
      allow delete: if isAdmin();

      // Nested user-owned subcollections (e.g. /users/{userId}/businesses/{businessId})
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // PRIVATE Sites collection: Strictly private! NO public get access.
    // Restricted strictly to document owner or admin, with ownership immutability.
    match /sites/{siteId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (
        ( 'userId' in resource.data && resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid ) ||
        request.auth.token.email == 'siphom.yati@gmail.com'
      );
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(resource.data) && maintainsOwnership(request.resource.data, resource.data))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    // PUBLIC Previews collection: Public single-doc read access ONLY for clients viewing website presentation prototypes.
    // Sanitized document containing presentation layout, theme colors, copy, and client feedback (no private CRM notes).
    match /publicPreviews/{previewToken} {
      allow get: if true;
      allow list: if isSignedIn() && (
        ( 'userId' in resource.data && resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid ) ||
        request.auth.token.email == 'siphom.yati@gmail.com'
      );
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        !('userId' in request.resource.data) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(resource.data) && maintainsOwnership(request.resource.data, resource.data))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());

      // Telemetry events subcollection (e.g. /publicPreviews/{previewToken}/events/{eventId})
      // Direct anonymous client writes are strictly denied. All telemetry events must pass through server ingestion endpoints.
      match /events/{eventId} {
        allow create: if false;
        allow read: if isSignedIn() && (
          (exists(/databases/$(database)/documents/publicPreviews/$(previewToken)) && 
           isOwner(get(/databases/$(database)/documents/publicPreviews/$(previewToken)).data)) || 
          isAdmin()
        );
        allow update, delete: if isSignedIn() && isAdmin();
      }

      // Leads subcollection (e.g. /publicPreviews/{previewToken}/leads/{leadId})
      // Direct client writes are denied; must use server endpoint. Read is restricted to owner or admin.
      match /leads/{leadId} {
        allow create: if false;
        allow read: if isSignedIn() && (
          (exists(/databases/$(database)/documents/publicPreviews/$(previewToken)) && 
           isOwner(get(/databases/$(database)/documents/publicPreviews/$(previewToken)).data)) || 
          isAdmin()
        );
        allow update, delete: if isSignedIn() && isAdmin();
      }
    }

    // Prospects / Businesses collection: strict user ownership & isolation
    match /businesses/{businessId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (
        ( 'userId' in resource.data && resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid ) ||
        request.auth.token.email == 'siphom.yati@gmail.com'
      );
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(resource.data) && maintainsOwnership(request.resource.data, resource.data))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());

      // Prospect subcollections: activities, notes, followups, etc. (respects parent business ownership)
      match /activities/{activityId} {
        allow read, write: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data) || 
          isAdmin()
        );
      }

      match /notes/{noteId} {
        allow read, write: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data) || 
          isAdmin()
        );
      }

      match /followups/{followUpId} {
        allow read, write: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data) || 
          isAdmin()
        );
      }

      // Qualification audit events: append-only history. Ordinary users cannot edit or delete!
      match /qualification_audits/{auditId} {
        allow read, create: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data) || 
          isAdmin()
        );
        allow update, delete: if isSignedIn() && isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data) || 
          isAdmin()
        );
      }
    }

    // Proposals collection: strict user ownership isolation & secure access
    match /proposals/{proposalId} {
      // Accessible only if explicitly flagged public with token, or owned by caller
      allow get: if (resource.data.get('isPublic', false) == true) || (isSignedIn() && (isOwner(resource.data) || isAdmin()));
      // Listing/querying restricted strictly to document owner or admin
      allow list: if isSignedIn() && (
        ( 'userId' in resource.data && resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid ) ||
        request.auth.token.email == 'siphom.yati@gmail.com'
      );
      // Creating proposals requires setting userId/ownerId to caller's UID
      allow create: if isSignedIn() && (
        ( 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid ) ||
        ( 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid ) ||
        isAdmin()
      );
      // Updating or deleting proposal requires ownership or admin, plus immutable ownership fields
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(resource.data) && maintainsOwnership(request.resource.data, resource.data))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }
  }
}
