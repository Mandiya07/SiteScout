rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is a verified admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // User profile: Users can read their own profile, but CANNOT escalate their own role
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Users can create/update their profile, but role cannot be self-elevated unless created as standard 'User'
      allow create: if request.auth != null && request.auth.uid == userId && (request.resource.data.role == 'User' || !('role' in request.resource.data));
      allow update: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Sites collection: Strict ownership enforcement. Only creator or admin can modify/delete.
    match /sites/{siteId} {
      allow read: if true; // Public read for presentation rendering
      allow create: if request.auth != null && (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Prospects / Businesses collection: strictly authenticated
    match /businesses/{businessId} {
      allow read, write: if request.auth != null;
    }

    // Proposals collection: owner secured
    match /proposals/{proposalId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
