{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/search/(.*)",
      "destination": "/api/search"
    },
    {
      "source": "/api/discover-prospects",
      "destination": "/api/discover-prospects"
    },
    {
      "source": "/api/discover-prospects/(.*)",
      "destination": "/api/discover-prospects"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
