{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/search/(.*)",
      "destination": "/api/search"
    },
    {
      "source": "/api/discover-prospects",
      "destination": "/api/discover-prospects"
    },
    {
      "source": "/api/discover-prospects/(.*)",
      "destination": "/api/discover-prospects"
    },
    {
      "source": "/api/send-demo-website",
      "destination": "/api/send-demo-website"
    },
    {
      "source": "/api/send-demo-website/(.*)",
      "destination": "/api/send-demo-website"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "firebase-applet-config.json"
    }
  }
}
